{
  "name": "jarvis",
  "productName": "JARVIS",
  "version": "0.1.0",
  "description": "JARVIS — персональная ИИ-система (этап 1: ядро)",
  "private": true,
  "main": "dist/main/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "dist": "npm run build && electron-builder --win --x64",
    "smoke": "npm run build && node scripts/smoke.mjs && node scripts/smoke-voice.mjs && node scripts/smoke-computer.mjs && node scripts/smoke-dev.mjs && node scripts/smoke-hud.mjs && node scripts/smoke-profile.mjs && node --experimental-strip-types scripts/smoke-crm.mjs && node scripts/smoke-jobs.mjs && node scripts/smoke-gateway.mjs && node scripts/smoke-telephony.mjs && node scripts/smoke-space.mjs && node scripts/smoke-telegram.mjs && node scripts/smoke-studio.mjs && node scripts/smoke-briefing.mjs && node scripts/smoke-agents.mjs && node --experimental-strip-types scripts/smoke-mentor.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "fflate": "0.8.3",
    "ffmpeg-static": "5.3.0",
    "imapflow": "1.0.164",
    "playwright-core": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "build": {
    "appId": "ru.cyberlos.jarvis",
    "productName": "JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  }
}
